# /opt/shorts/vk.env  (chmod 600, root:root). В git и в чат - никогда.
VK_GROUP_ID=229049334
# ключ доступа сообщества: Управление -> Дополнительно -> Работа с API -> Ключи доступа
VK_COMMUNITY_TOKEN=
# приложение VK ID (после одобрения прав devsupport); пара ключей админа - в /opt/shorts/vk_user.json
VK_CLIENT_ID=
# 1 = ставить посты в отложку ВК самому (нужен ключ админа с правом wall); 0 = пакеты в группу GSPC
VK_AUTO=0
# 1 = первые 15 с каждого клипа историей (нужен ключ сообщества с правом stories)
VK_STORIES=0
# до подтверждения бизнес-профиля VK ID - 10000 вызовов в месяц
VK_MONTHLY_LIMIT=10000
# модель, которая пишет тексты (прокси подписки :8650)
VK_WRITER_MODEL=grok-4.3
